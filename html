<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Trading Pro - Irfan Quotex Signal</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #0b1120; color: #e2e8f0; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .app-container { width: 100%; max-width: 450px; }
        
        /* Header */
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
        .logo { font-size: 22px; font-weight: bold; color: #3b82f6; display: flex; align-items: center; gap: 8px; }
        .status { color: #10b981; font-size: 12px; font-weight: bold; display: flex; align-items: center; gap: 5px; }
        .status::before { content: ''; width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block; }
        .subtitle { font-size: 13px; color: #94a3b8; margin-bottom: 20px; }

        /* Cards */
        .card { background-color: #151f32; border: 1px solid #1e293b; border-radius: 12px; padding: 16px; margin-bottom: 16px; }
        .card-title { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }

        /* Inputs */
        input[type="text"] { width: 100%; background: #0f172a; border: 1px solid #334155; color: white; padding: 12px; border-radius: 8px; font-size: 14px; outline: none; }
        input[type="text"]:focus { border-color: #3b82f6; }
        .note { font-size: 12px; color: #64748b; margin-top: 8px; }

        /* Dropdowns */
        .dropdown-row { display: flex; gap: 10px; }
        select { width: 100%; background: #0f172a; border: 1px solid #334155; color: white; padding: 12px; border-radius: 8px; font-size: 14px; outline: none; appearance: none; }

        /* Live Price */
        .price-display { font-size: 24px; font-weight: bold; margin: 10px 0 5px 0; letter-spacing: 2px; }
        .price-status { font-size: 13px; color: #94a3b8; }

        /* Signal */
        .signal-card { text-align: center; padding: 30px 16px; }
        .signal-text { font-size: 48px; font-weight: 900; margin: 15px 0; letter-spacing: 2px; }
        .signal-wait { color: #facc15; }
        .signal-up { color: #10b981; }
        .signal-down { color: #ef4444; }
        .indicator-score { font-size: 14px; color: #e2e8f0; margin-bottom: 8px; }
        .signal-message { font-size: 12px; color: #64748b; margin-bottom: 25px; }

        /* Buttons */
        .btn-row { display: flex; gap: 10px; }
        .btn { flex: 1; padding: 14px; border: none; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; transition: 0.2s; }
        .btn-analyze { background: #3b82f6; color: white; }
        .btn-analyze:hover { background: #2563eb; }
        .btn-voice { background: #1e293b; color: #e2e8f0; }
        .btn-voice:hover { background: #334155; }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- Header -->
        <div class="header">
            <div class="logo">✨ AI TRADING PRO</div>
            <div class="status">DEMO</div>
        </div>
        <div class="subtitle">Smart Market Analysis (Irfan Quotex Signal)</div>

        <!-- API Key Card -->
        <div class="card">
            <div class="card-title">Twelve Data API Key</div>
            <input type="password" id="apiKey" placeholder="Enter your API key">
            <div class="note">Key is not saved in this page. Do not share it.</div>
        </div>

        <!-- Market & Timeframe Card -->
        <div class="card">
            <div class="card-title">Select Market</div>
            <div class="dropdown-row">
                <select id="market">
                    <option value="EUR/USD">EUR/USD</option>
                    <option value="GBP/USD">GBP/USD</option>
                    <option value="USD/JPY">USD/JPY</option>
                    <option value="BTC/USD">BTC/USD</option>
                    <option value="ETH/USD">ETH/USD</option>
                </select>
                <select id="timeframe">
                    <option value="1min">1 Minute</option>
                    <option value="5min" selected>5 Minutes</option>
                    <option value="15min">15 Minutes</option>
                    <option value="30min">30 Minutes</option>
                    <option value="1h">1 Hour</option>
                </select>
            </div>
        </div>

        <!-- Live Price Card -->
        <div class="card">
            <div class="card-title">Live Price</div>
            <div class="price-display" id="livePrice">---</div>
            <div class="price-status" id="priceStatus">Waiting for market data</div>
        </div>

        <!-- Signal Card -->
        <div class="card signal-card">
            <div class="card-title" style="text-align: center;">AI TRADING SIGNAL</div>
            <div class="signal-text signal-wait" id="signalText">WAIT</div>
            <div class="indicator-score" id="indicatorScore">Indicator score: --</div>
            <div class="signal-message" id="signalMessage">Enter API key and analyze market.</div>
            
            <div class="btn-row">
                <button class="btn btn-analyze" onclick="analyzeMarket()">⚡ ANALYZE MARKET</button>
                <button class="btn btn-voice" id="voiceBtn" onclick="toggleVoice()">🔊 VOICE OFF</button>
            </div>
        </div>
    </div>

    <script>
        // Voice Feature
        let voiceEnabled = false;
        function toggleVoice() {
            voiceEnabled = !voiceEnabled;
            const btn = document.getElementById('voiceBtn');
            btn.innerHTML = voiceEnabled ? "🔊 VOICE ON" : "🔊 VOICE OFF";
            btn.style.color = voiceEnabled ? "#10b981" : "#e2e8f0";
        }

        function speak(text) {
            if (!voiceEnabled) return;
            const speech = new SpeechSynthesisUtterance(text);
            speech.lang = 'en-US';
            window.speechSynthesis.speak(speech);
        }

        // --- MAIN BOT LOGIC (Pattern Recognition) ---
        async function analyzeMarket() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const market = document.getElementById('market').value;
            const timeframe = document.getElementById('timeframe').value;
            
            const signalText = document.getElementById('signalText');
            const priceDisplay = document.getElementById('livePrice');
            const priceStatus = document.getElementById('priceStatus');
            const scoreText = document.getElementById('indicatorScore');
            const msgText = document.getElementById('signalMessage');

            if (!apiKey) {
                msgText.innerText = "⚠️ Please enter a valid Twelve Data API Key.";
                msgText.style.color = "#ef4444";
                return;
            }

            // Set loading state
            signalText.innerText = "...";
            signalText.className = "signal-text signal-wait";
            priceStatus.innerText = "Fetching data...";
            msgText.innerText = "Analyzing candles...";

            try {
                // Fetching data from Twelve Data
                const response = await fetch(`https://api.twelvedata.com/time_series?symbol=${market}&interval=${timeframe}&outputsize=5&apikey=${apiKey}`);
                const data = await response.json();

                if (data.status === "error") {
                    throw new Error(data.message);
                }

                const candles = data.values; // API returns newest first
                const currentPrice = parseFloat(candles[0].close).toFixed(4);
                
                // Display Price
                priceDisplay.innerText = currentPrice;
                priceStatus.innerText = `Last updated: ${new Date().toLocaleTimeString()}`;

                // Variables for current and previous candles
                const c0 = candles[0]; // Current (just closed)
                const c1 = candles[1]; // Previous
                const c2 = candles[2]; // Previous-2

                const o0 = parseFloat(c0.open), h0 = parseFloat(c0.high), l0 = parseFloat(c0.low), cl0 = parseFloat(c0.close);
                const o1 = parseFloat(c1.open), cl1 = parseFloat(c1.close);
                
                let signal = "WAIT";
                let pattern = "No strong pattern found";
                let colorClass = "signal-wait";

                // --- PATTERN LOGIC ---
                const body0 = Math.abs(cl0 - o0);
                const lowerShadow0 = Math.min(o0, cl0) - l0;
                const upperShadow0 = h0 - Math.max(o0, cl0);

                // 1. Hammer
                if (lowerShadow0 > 2 * body0 && upperShadow0 < 0.1 * body0 && body0 > 0) {
                    signal = "UP"; pattern = "Hammer Pattern"; colorClass = "signal-up";
                } 
                // 2. Shooting Star
                else if (upperShadow0 > 2 * body0 && lowerShadow0 < 0.1 * body0 && body0 > 0) {
                    signal = "DOWN"; pattern = "Shooting Star"; colorClass = "signal-down";
                }
                // 3. Bullish Engulfing
                else if (cl1 < o1 && cl0 > o0 && cl0 > o1 && o0 < cl1) {
                    signal = "UP"; pattern = "Bullish Engulfing"; colorClass = "signal-up";
                }
                // 4. Bearish Engulfing
                else if (cl1 > o1 && cl0 < o0 && cl0 < o1 && o0 > cl1) {
                    signal = "DOWN"; pattern = "Bearish Engulfing"; colorClass = "signal-down";
                }

                // Update UI
                signalText.innerText = signal === "UP" ? "BUY (UP)" : signal === "DOWN" ? "SELL (DOWN)" : "WAIT";
                signalText.className = `signal-text ${colorClass}`;
                scoreText.innerText = `Indicator score: ${signal === "WAIT" ? "--" : "Strong"}`;
                msgText.innerText = `Detected: ${pattern}`;
                msgText.style.color = "#94a3b8";

                // Voice Alert
                if (signal !== "WAIT") {
                    speak(`${signal} signal detected on ${market} due to ${pattern}`);
                }

            } catch (error) {
                signalText.innerText = "ERROR";
                signalText.className = "signal-text signal-down";
                msgText.innerText = error.message || "Failed to fetch data. Check API key.";
                msgText.style.color = "#ef4444";
                priceStatus.innerText = "Connection failed.";
            }
        }
    </script>
</body>
</html>
